# Copy to .env.local for local use. Never commit real keys.
# The library, verdicts and checks work with nothing set here.

# ---- Live research: an AI key ----
# Optional. Visitors can add their own key in the site under "AI key" instead; it is kept
# encrypted in an HttpOnly cookie. A key set here is the site's own key, used when a visitor has none.
# Set any one of these. GOOGLE_API_KEY also works for Gemini.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# With several keys: anthropic | google | openai. Unset = the first key found, in the order
# Anthropic, Google, OpenAI. If it names a provider with no key, no server key is used.
LLM_PROVIDER=
# Model for the site's key. Defaults: claude-sonnet-5-5, gemini-3.8-flash, gpt-6.1-sol
# (CLAUDE_MODEL is still read for Anthropic, as a legacy alias.)
LLM_MODEL=

# ---- Required in production if visitors add keys in the site ----
# Encrypts the key cookie. Any random string of 32+ characters (at least 16), e.g. `openssl rand -hex 32`.
# Locally a secret is created in .data/app-secret automatically. On Vercel, without it the site refuses
# to store keys. Changing it signs everyone out of their key.
APP_SECRET=

# ---- Optional: durable storage ----
# Without these, generated guides, run logs and rate-limit counters are stored in .data/ locally, or in
# memory on serverless hosts (where share links and limits last only as long as the instance).
# On Vercel, add the Upstash integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel's KV/Upstash integration may set these names instead; either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Optional: tuning (defaults shown; values outside the range in brackets are clamped) ----
# low | medium | high. (CLAUDE_RESEARCH_EFFORT / CLAUDE_EXTRACT_EFFORT are legacy aliases.)
LLM_RESEARCH_EFFORT=medium
LLM_EXTRACT_EFFORT=low
# Searches and pages the model may use while researching [1-15] / [0-15]
MAX_SEARCHES=6
MAX_FETCHES=6
# Cited pages the server reads itself so quotes can be checked, whichever provider ran [0-20]
VERIFY_FETCHES=8
# Time limits in ms [20000-240000] / [20000-200000]. A whole run is also capped at 280 s
# (the API route's limit is 300 s), and stage limits shrink to fit.
RESEARCH_TIMEOUT_MS=150000
EXTRACT_TIMEOUT_MS=110000
# Live runs per network per hour (all keys) [1-1000], and per day on the site's own key [1-100000]
RUNS_PER_IP_PER_HOUR=20
DAILY_RUN_CAP=150
# Days a generated guide is kept and reused [1-90]
GUIDE_CACHE_DAYS=7
# Anthropic only: basic = every search and page read is visible as it happens; dynamic = dynamic filtering
WEB_TOOLS=basic
# Anthropic only: server-side refusal fallback. Set to "off" on Bedrock/Vertex/Foundry.
CLAUDE_FALLBACKS=on
# Absolute site URL for link previews (Vercel sets its own; set this elsewhere)
NEXT_PUBLIC_SITE_URL=

# ---- Tests only: set to 1 to replace the model with a fixture (output is labelled MOCK). ----
# Never set in production.
AGENT_MOCK=
