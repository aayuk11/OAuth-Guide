# Copy to .env.local for local use. Never commit real keys.
# The library, verdicts and checks work with nothing set here.

# ---- Live research: an AI key ----
# Optional. Visitors can add their own key in the site under "AI key" instead; it is kept
# encrypted in an HttpOnly cookie. A key set here is the site's own key, used when a visitor has none.
# Set any one of these. With several, LLM_PROVIDER picks (anthropic | google | openai).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=
# Model for the site's key. Defaults: claude-sonnet-5-5, gemini-3.8-flash, gpt-6.1-sol
LLM_MODEL=

# ---- Required in production if visitors add keys in the site ----
# Encrypts the key cookie. Any random string of 32+ characters, e.g. `openssl rand -hex 32`.
# Locally a secret is created in .data/app-secret automatically. Changing it signs everyone out of their key.
APP_SECRET=

# ---- Optional: durable storage ----
# Without these, generated guides are stored in .data/ locally, or in memory on serverless hosts
# (where share links last only as long as the instance). On Vercel, add the Upstash integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel's KV/Upstash integration may set these names instead; either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Optional: tuning (defaults shown) ----
LLM_RESEARCH_EFFORT=medium
LLM_EXTRACT_EFFORT=low
MAX_SEARCHES=6
MAX_FETCHES=6
# Cited pages the server reads itself so quotes can be checked, whichever provider ran
VERIFY_FETCHES=8
RESEARCH_TIMEOUT_MS=150000
EXTRACT_TIMEOUT_MS=110000
# Live runs per network per hour (all keys), and per day on the site's own key
RUNS_PER_IP_PER_HOUR=20
DAILY_RUN_CAP=150
GUIDE_CACHE_DAYS=7
# Anthropic only: basic = every search and page read is visible as it happens; dynamic = dynamic filtering
WEB_TOOLS=basic
# Anthropic only: server-side refusal fallback. Set to "off" on Bedrock/Vertex/Foundry.
CLAUDE_FALLBACKS=on
# Absolute site URL for link previews (Vercel sets its own; set this elsewhere)
NEXT_PUBLIC_SITE_URL=

# ---- Tests only: replace the model with a fixture (output is labelled MOCK). Never set in production. ----
AGENT_MOCK=
