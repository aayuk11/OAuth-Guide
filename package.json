    "validate": "tsx scripts/validate-guides.ts",
    "verify:sources": "tsx scripts/verify-sources.ts",
    "data:sync": "tsx scripts/sync-composio.ts",
    "guides:index": "tsx scripts/build-guide-index.ts",
    "eval:agent": "tsx scripts/run-agent.ts eval",
    "rehearse": "tsx scripts/run-agent.ts rehearse",
    "generate": "tsx scripts/run-agent.ts one",
    "check:key": "tsx scripts/check-key.ts",
    "qa:overflow": "node scripts/overflow.mjs",
    "qa:keys": "node scripts/qa-key-flow.mjs",
    "qa:screens": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@google/genai": "^2.30.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "openai": "^7.39.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
