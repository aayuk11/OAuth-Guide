{
  "name": "oauth-readiness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/build-guide-index.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/build-guide-index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
